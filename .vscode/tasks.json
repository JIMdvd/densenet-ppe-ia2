{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Comprobar GPU CUDA",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/check_gpu.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Entrenar DenseNet121 cinco epocas",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/train.py", "--epochs", "5", "--batch-size", "8", "--image-size", "128"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
